# Copy this file to .env.local (on your computer) or paste these into
# Vercel → Project → Settings → Environment Variables. SETUP.md explains each one.

# --- Supabase (database + login) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# A random string of 40+ characters. Never change it once ad accounts are connected.
TOKEN_ENCRYPTION_KEY=

# Your live address, e.g. https://holmos.vercel.app (no trailing slash).
APP_URL=

# --- Meta Ads ---
META_APP_ID=
META_APP_SECRET=
# Only if your Meta app uses "Facebook Login for Business":
META_LOGIN_CONFIG_ID=
# META_API_VERSION=v26.0

# --- Google (one Google Cloud login, used by Google Ads and Google Calendar) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only for Google Ads:
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v25

# --- Emails: booking confirmations, reminders, new-answer alerts (resend.com) ---
RESEND_API_KEY=
# Who emails come from, on a domain you've verified in Resend,
# e.g. HolmNordic <booking@mail.holmnordic.dk>
EMAIL_FROM=

# --- Booking reminders: Vercel's daily cron job proves itself with this. ---
# A random string of 32+ characters.
CRON_SECRET=
